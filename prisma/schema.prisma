generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  /// bcrypt hash only. Never store or return the plain password.
  password          String
  /// When the password last changed. Sessions signed in before this are ended
  /// (see the jwt callback in auth.ts).
  passwordChangedAt DateTime?
  phoneNumber       String?
  /// Profile image URL.
  image             String?   @db.VarChar(2048)
  /// Role id (Role.id), e.g. admin, manager, sales, stock.
  role              String
  roleRef           Role      @relation(fields: [role], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Soft delete: a deleted user cannot sign in and is hidden everywhere. Every query
  /// must filter `deletedAt: null`.
  deletedAt         DateTime?

  passwordResetTokens PasswordResetToken[]
  adjustments         Adjustment[]

  // Users list: active users, newest first.
  @@index([deletedAt, createdAt])
}

/// Staff roles. Filled with the design's four roles (design/src/data/people-data.js);
/// the Roles page will manage this table. Permissions per role are still in
/// lib/permissions.ts until then.
model Role {
  /// Stable key used in code and on User.role, e.g. "admin".
  id          String   @id @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Badge colour from the design: navy, info, success, warning, neutral.
  tone        String   @default("neutral") @db.VarChar(20)
  /// Built-in role (admin) that the Roles page must not delete.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  // Only the name is required; the rest are optional.
  email       String?
  phoneNumber String?
  country     String?
  city        String?
  zipCode     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because stock, sales and
  /// purchases will reference warehouses. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  stocks      ProductStock[]
  adjustments Adjustment[]

  // List page: active warehouses, newest first.
  @@index([deletedAt, createdAt])
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  // Only the name is required; the rest are optional (same as Warehouse).
  email       String?
  phoneNumber String?
  country     String?
  city        String?
  address     String?   @db.VarChar(500)
  /// Thai taxpayer ID, 13 digits, stored without spaces or dashes.
  taxId       String?   @db.VarChar(13)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because purchases will
  /// reference suppliers. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  products Product[]

  // List page: active suppliers, newest first.
  @@index([deletedAt, createdAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  // Name and province (city) are required; the rest are optional.
  phoneNumber String?
  country     String?
  /// Province from the design's list (lib/thai-provinces.ts), or "ต่างประเทศ".
  city        String
  address     String?   @db.VarChar(500)
  /// Default credit term as a code: "cash" or "1m" … "12m" (calendar months, which are
  /// not a fixed number of days). Allowed values and the billing rule: lib/credit-terms.ts.
  creditTerm  String    @default("cash") @db.VarChar(10)
  /// Set only on built-in records. "direct-customer" is the POS walk-in customer used
  /// when no customer is chosen: it must never be deleted, and the POS finds it by this
  /// key (not by name, which may be edited). Unique, so there is only ever one.
  systemKey   String?   @unique @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because sales and quotations
  /// will reference customers. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  // List page: active customers, newest first.
  @@index([deletedAt, createdAt])
}

/// Product category (design/src/pages/categories.page.html). The fabric fields are
/// defaults for every product in the category; all of them are optional.
model Category {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  /// Three letters A–Z, the "AAA" part of product codes (COT58A101001). Unique among
  /// active categories (checked in the server actions; MySQL has no partial indexes).
  code        String    @db.VarChar(3)
  /// Category image URL (uploaded file).
  image       String?   @db.VarChar(2048)
  /// e.g. "ฝ้าย 98%, สแปนเด็กซ์ 2%".
  composition String?   @db.VarChar(200)
  /// One of WEAVES in lib/category-options.ts.
  weave       String?   @db.VarChar(50)
  /// One of PATTERNS in lib/category-options.ts.
  pattern     String?   @db.VarChar(50)
  /// Fabric width in inches.
  widthInches Decimal?  @db.Decimal(5, 1)
  /// Fabric weight in grams per square metre.
  gsm         Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: products will reference categories. Every query must filter
  /// `deletedAt: null`.
  deletedAt   DateTime?

  products Product[]

  // List page: active categories, newest first.
  @@index([deletedAt, createdAt])
  @@index([code])
}

/// A fabric (design/src/pages/create-product.page.html). There is deliberately no stock
/// column: stock is per warehouse in ProductStock. There is also no price: the design sets
/// the purchase price on each purchase and the sale price on each sale.
model Product {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(200)
  /// 12 characters, AAA00B111222: category code (3 letters), width in inches (2 digits),
  /// lot (1 letter), pattern (3 digits), colour (3 digits). Unique among active products
  /// (checked in the server actions, like Category.code).
  code        String    @db.VarChar(12)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Main supplier. Required by the product form; nullable only for products created
  /// before this field existed.
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// e.g. "สีคราม".
  colorName   String?   @db.VarChar(100)
  /// Barcode type for printing labels: "CODE128" or "CODE39".
  barcodeType String    @default("CODE128") @db.VarChar(20)
  /// Stock unit. The design fixes it to yards ("yard"): bought, sold and counted in yards.
  unit        String    @default("yard") @db.VarChar(20)
  /// "Low stock" when the total across warehouses is at or below this many units.
  stockAlert  Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: purchases, sales and transfers will reference products. Every query
  /// must filter `deletedAt: null`.
  deletedAt   DateTime?

  images          ProductImage[]
  stocks          ProductStock[]
  adjustmentItems AdjustmentItem[]

  // List page: active products, newest first.
  @@index([deletedAt, createdAt])
  @@index([code])
  @@index([categoryId])
  @@index([supplierId])
}

/// Product photos, in display order; position 0 is the cover (list thumbnail).
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Uploaded file URL (/api/uploads/products/…).
  url       String   @db.VarChar(2048)
  position  Int
  createdAt DateTime @default(now())

  @@index([productId, position])
}

/// Quantity of a product held in a warehouse: the only place stock is stored. One row per
/// product × warehouse. Changed by the initial stock on create now, and later by purchases,
/// sales, transfers and adjustments.
model ProductStock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// In the product's unit (yards).
  quantity    Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

/// A stock adjustment (design/src/pages/adjustment.page.html): manual corrections to one
/// warehouse's stock, e.g. after a count or for damaged cloth. Its items are applied to
/// ProductStock in the same transaction that creates it (lib/stock.ts).
model Adjustment {
  id          String    @id @default(cuid())
  /// Document number, e.g. "ADJ-2569-0013" (lib/references.ts).
  reference   String    @unique @db.VarChar(30)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// The adjustment's date (a calendar day; not in the future).
  date        DateTime  @db.Date
  /// One of ADJUSTMENT_REASONS in lib/adjustments.ts.
  reason      String    @db.VarChar(50)
  notes       String?   @db.VarChar(1000)
  /// Who made it (the reason trail). Kept if the user is later deleted (soft delete).
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  items AdjustmentItem[]

  // List page: active adjustments, newest first.
  @@index([deletedAt, createdAt])
  @@index([warehouseId])
}

enum AdjustmentType {
  ADDITION
  SUBTRACTION
}

/// One product line of an adjustment.
model AdjustmentItem {
  id           String         @id @default(cuid())
  adjustmentId String
  adjustment   Adjustment     @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Always positive; `type` says whether it was added or taken away. In the product's unit.
  quantity     Decimal        @db.Decimal(12, 2)
  type         AdjustmentType
  /// The warehouse's stock of this product just before and after this line was applied.
  stockBefore  Decimal        @db.Decimal(12, 2)
  stockAfter   Decimal        @db.Decimal(12, 2)

  // A product appears at most once per adjustment.
  @@unique([adjustmentId, productId])
  @@index([productId])
}

/// Running numbers for document references, one row per series (e.g. "ADJ-2569").
/// Incremented inside the transaction that creates the document (lib/references.ts).
model DocumentSequence {
  key        String   @id @db.VarChar(30)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  /// SHA-256 of the emailed token. The token itself is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
