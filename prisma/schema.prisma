generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  /// bcrypt hash only. Never store or return the plain password.
  password    String
  /// When the password last changed. Sessions signed in before this are ended
  /// (see the jwt callback in auth.ts).
  passwordChangedAt DateTime?
  phoneNumber String?
  /// Profile image URL.
  image       String?  @db.VarChar(2048)
  /// Role id (Role.id), e.g. admin, manager, sales, stock.
  role        String
  roleRef     Role     @relation(fields: [role], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft delete: a deleted user cannot sign in and is hidden everywhere. Every query
  /// must filter `deletedAt: null`.
  deletedAt   DateTime?

  passwordResetTokens PasswordResetToken[]

  // Users list: active users, newest first.
  @@index([deletedAt, createdAt])
}

/// Staff roles. Filled with the design's four roles (design/src/data/people-data.js);
/// the Roles page will manage this table. Permissions per role are still in
/// lib/permissions.ts until then.
model Role {
  /// Stable key used in code and on User.role, e.g. "admin".
  id          String   @id @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Badge colour from the design: navy, info, success, warning, neutral.
  tone        String   @default("neutral") @db.VarChar(20)
  /// Built-in role (admin) that the Roles page must not delete.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  // Only the name is required; the rest are optional.
  email       String?
  phoneNumber String?
  country     String?
  city        String?
  zipCode     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because stock, sales and
  /// purchases will reference warehouses. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  // List page: active warehouses, newest first.
  @@index([deletedAt, createdAt])
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  // Only the name is required; the rest are optional (same as Warehouse).
  email       String?
  phoneNumber String?
  country     String?
  city        String?
  address     String?   @db.VarChar(500)
  /// Thai taxpayer ID, 13 digits, stored without spaces or dashes.
  taxId       String?   @db.VarChar(13)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because purchases will
  /// reference suppliers. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  // List page: active suppliers, newest first.
  @@index([deletedAt, createdAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  // Name and province (city) are required; the rest are optional.
  phoneNumber String?
  country     String?
  /// Province from the design's list (lib/thai-provinces.ts), or "ต่างประเทศ".
  city        String
  address     String?   @db.VarChar(500)
  /// Default credit term as a code: "cash" or "1m" … "12m" (calendar months, which are
  /// not a fixed number of days). Allowed values and the billing rule: lib/credit-terms.ts.
  creditTerm  String    @default("cash") @db.VarChar(10)
  /// Set only on built-in records. "direct-customer" is the POS walk-in customer used
  /// when no customer is chosen: it must never be deleted, and the POS finds it by this
  /// key (not by name, which may be edited). Unique, so there is only ever one.
  systemKey   String?   @unique @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set this instead of deleting the row, because sales and quotations
  /// will reference customers. Every query must filter `deletedAt: null`.
  deletedAt   DateTime?

  // List page: active customers, newest first.
  @@index([deletedAt, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  /// SHA-256 of the emailed token. The token itself is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
